{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/app/*": ["./src/app/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/public/*": ["./src/app/(pages)/(public)/*"],
      "@/login/*": ["./src/app/(pages)/(public)/login/*"],
      "@/admin/*": ["./src/app/(pages)/(portal)/admin/*"],
      "@/job-seeker/*": ["./src/app/(pages)/(portal)/(job-seeker)/*"],
      "@/constants/*": ["./src/lib/configs/constants/*"],
      "@/utils/*": ["./src/lib/utils/*"],
      "@/helpers/*": ["./src/lib/helpers/*"],
      "@/components/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/employers/*": ["./src/app/(pages)/(portal)/admin/employers/*"],
      "@/types/*": ["./src/types/*"],
      "@/ds/*": ["./src/components/design-system/*"],
      "@/services/*": ["./src/services/*"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
