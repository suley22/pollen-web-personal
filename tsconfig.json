{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/login/*": ["./src/app/(pages)/login/*"],
      "@/admin/*": ["./src/app/(pages)/(portal)/admin/*"],
      "@/job-seeker/*": ["./src/app/(pages)/(portal)/(job-seeker)/*"],
      "@/constants/*": ["./src/lib/configs/constants/*"],
      "@/utils/*": ["./src/lib/utils/*"],
      "@/components/*": ["./src/lib/_components/*"]
    },
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": false
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "src/app/components/sidebar/navigation-items.jsx"
  ],
  "exclude": ["node_modules"]
}
